# ToS_Companion web service
# companion_auth remains the sole Schwab OAuth/token owner.
AUTH_HELPER_URL=http://companion-auth.p3l.co

# Required for Schwab reauthorization mutations. Configure the matching
# Cloudflare Access application/policy before enabling the button.
TOS_CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
TOS_CLOUDFLARE_ACCESS_AUD=
TOS_ADMIN_EMAILS=

TOS_COMPANION_HOST=127.0.0.1
TOS_COMPANION_PORT=8787
TOS_COMPANION_LOG_LEVEL=info

# Existing optional application settings may be added here.
# Do not place Schwab refresh tokens in this file.
