# Required. Must match companion-auth INTERNAL_AUTH_SECRET.
INTERNAL_AUTH_SECRET=

# LLM analysis uses the host-authenticated Codex CLI bridge.
# Signed Cloudflare Access admin boundary for Schwab reauthorization.
TOS_CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
TOS_CLOUDFLARE_ACCESS_AUD=
TOS_ADMIN_EMAILS=
# No OpenAI API key belongs in this file.
